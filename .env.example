# Event Icebreaker environment configuration
#
# Copy to `.env` (git-ignored; never commit real values) and set values BEFORE
# building — NEXT_PUBLIC_* variables are inlined into the client bundle at
# build time. Unset variables degrade gracefully; nothing here is required.

# ---------------------------------------------------------------------------
# Two-way match (optional) — the stateless Laya sidecar
# ---------------------------------------------------------------------------
# Base URL of the sidecar (see laya-sidecar/). Unset = the receiver renders
# the on-device "local estimate" instead of the model dossier.
# NEXT_PUBLIC_LAYA_URL=https://laya-sidecar.example.com

# ---------------------------------------------------------------------------
# Monad testnet attestation (optional, default OFF)
# ---------------------------------------------------------------------------
# Enables the "Seal this match onchain" action in the receiver's match
# dossier. Accepts on | true | 1 — anything else, including unset, keeps the
# feature compiled out of the running app (no attestation code loads, no
# chain requests are made). See README "Optional: Monad testnet attestation"
# before enabling: a wallet must be provisioned and funded by you first.
# NEXT_PUBLIC_MINT_MODE=on
#
# Optional infrastructure overrides (defaults are Monad's official testnet
# endpoints, docs.monad.xyz → "Network Information - Testnet", chain id 10143).
# NEXT_PUBLIC_MINT_RPC_URL=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_MINT_EXPLORER_URL=https://testnet.monadvision.com
